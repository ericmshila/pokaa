# Copy this file to .env.local — but you usually don't need to.
#
# By default (no VITE_API_BASE_URL set), the app talks to whatever
# host the browser used to load this page, on port 8000. That means
# it works unmodified whether you open it via localhost, a LAN IP, or
# a Hamachi/Tailscale virtual IP, as long as the backend is running
# on the same machine as the frontend on port 8000.
#
# Only set this if the backend lives on a different host/port than
# the frontend (e.g. backend on a separate server).

# VITE_API_BASE_URL=http://localhost:8000

# Usually derived automatically from VITE_API_BASE_URL (http -> ws).
# Only set this if your WebSocket endpoint lives on a different host.
# VITE_WS_BASE_URL=ws://localhost:8000
